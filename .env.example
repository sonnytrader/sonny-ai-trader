# Temel
PORT=3000
DATA_DIR=./data

# Tüm /api uç noktalarını korur. Canlı modda zorunludur.
# Uzun ve rastgele bir değer üretin; gerçek token'ı dosyaya işlemeyin.
ALPHASON_API_TOKEN=buraya_uzun_rastgele_token_yazin

# Bitget USDT-M — yalnızca okuma ve futures işlem yetkisi verin; çekim yetkisi vermeyin.
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=

# AI sağlayıcıları — yalnızca kullandıklarınızı doldurun.
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# İsteğe bağlı sağlayıcı günlük çağrı sınırları
AI_LIMIT_GEMINI=420
AI_LIMIT_GROQ=900
AI_LIMIT_DEEPSEEK=3000
AI_LIMIT_OPENAI=2000
